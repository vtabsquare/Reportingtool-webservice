# Server-only environment. Configure these in Railway/Render; do not ship this file in the EXE.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
VTAB_WEB_URL=https://YOUR_WEB_TOOL_DOMAIN
VTAB_ALLOWED_ORIGINS=https://YOUR_WEB_TOOL_DOMAIN
VTAB_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_A_PRIVATE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
VTAB_REFRESH_WORKER_ENABLED=1
VTAB_REFRESH_POLL_SECONDS=30
VTAB_EMAIL_WORKER_ENABLED=1
VTAB_EMAIL_POLL_SECONDS=15
VTAB_AUTOMATION_WORKER_ENABLED=1
VTAB_AUTOMATION_POLL_SECONDS=30
# Configure either Brevo HTTP delivery or SMTP. The sender must be verified by
# your provider; never commit the API key or SMTP password to source control.
VTAB_BREVO_API_KEY=
VTAB_BREVO_FROM_EMAIL=
VTAB_BREVO_SENDER_NAME=VTAB Reporting Services
VTAB_SMTP_HOST=
VTAB_SMTP_PORT=587
VTAB_SMTP_USERNAME=
VTAB_SMTP_PASSWORD=
VTAB_SMTP_FROM=
VTAB_SMTP_SSL=0
VTAB_SMTP_STARTTLS=1
VTAB_TICKET_CENTER_URL=https://ticketing.139.59.32.39.nip.io
VTAB_TICKET_INTEGRATION_KEY=REPLACE_WITH_SHARED_32_CHARACTER_KEY
