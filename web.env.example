# Reference copy for the Services Web Tool. A ready-to-edit web.env is
# included in the source package.
VTAB_ENVIRONMENT=development
VITE_APP_MODE=WORKSPACE_ONLY
VITE_SUPABASE_URL=https://REPLACE_WITH_YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SERVER_SERVICE_ROLE_KEY
VTAB_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_A_PRIVATE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
VTAB_REFRESH_WORKER_ENABLED=1
VTAB_REFRESH_POLL_SECONDS=30
# Brevo transactional email. Keep the real values only in the deployment
# environment; never place them in frontend VITE_* variables.
VTAB_BREVO_API_KEY=REPLACE_WITH_YOUR_BREVO_API_KEY
VTAB_BREVO_FROM_EMAIL=REPLACE_WITH_YOUR_VERIFIED_BREVO_SENDER_EMAIL
VTAB_BREVO_SENDER_NAME=VTAB Reporting Services
VTAB_EMAIL_WORKER_ENABLED=1
VTAB_EMAIL_POLL_SECONDS=15
VTAB_AUTOMATION_WORKER_ENABLED=1
VTAB_AUTOMATION_POLL_SECONDS=30
VTAB_ALLOW_EXTERNAL_EMAIL=0
VTAB_SUBSCRIPTION_MAX_RECIPIENTS=25
VTAB_SUBSCRIPTION_ATTACHMENT_MAX_BYTES=20971520
VITE_API_URL=http://127.0.0.1:8830/api/v1
VITE_WEB_URL=http://127.0.0.1:4173
VTAB_WEB_URL=http://127.0.0.1:4173
VTAB_ALLOWED_ORIGINS=http://127.0.0.1:4173
VTAB_API_HOST=127.0.0.1
VTAB_API_PORT=8830
VTAB_WEB_HOST=127.0.0.1
VTAB_WEB_PORT=4173
