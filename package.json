{
  "name": "vtab-reporting-studio-web",
  "private": true,
  "version": "6.1.10",
  "description": "VTAB Reporting Services with governed scheduled refresh",
  "author": "VTAB Square",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/build-frontend.mjs",
    "build:web": "cross-env VITE_APP_MODE=WORKSPACE_ONLY node tools/build-frontend.mjs",
    "preview": "vite preview",
    "test:visual-formatting": "node test_visual_formatting_contract.cjs",
    "test:map": "node test_advanced_map_engine.mjs",
    "test:desktop-parity": "node test_city_partition_runtime.mjs && node test_matrix_visual_runtime.mjs && node test_sorting_engine_runtime.mjs && node test_slicer_text_input_contract.mjs",
    "desktop": "electron .",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-backend.ps1",
    "release": "npm run build:backend && npm run build && electron-builder --win nsis --publish never --config.electronDownload.cache=.electron-cache"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/react-grid-layout": "1.3.5",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "4.3.4",
    "@xyflow/react": "12.8.2",
    "cross-env": "^10.1.0",
    "echarts": "5.6.0",
    "echarts-for-react": "3.0.2",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "^1.5.4",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "zustand": "5.0.2"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.vtabsquare.reportingstudio",
    "productName": "VTAB Reporting Studio",
    "copyright": "Copyright © 2026 VTAB Square",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist-web/**/*",
      "electron/**/*",
      "build-resources/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "api/dist/vtab-backend.exe",
        "to": "backend/vtab-backend.exe"
      },
      {
        "from": "desktop.env",
        "to": "desktop.env"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico",
      "artifactName": "VTAB Reporting Studio Setup ${version}.${ext}",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VTAB Reporting Studio",
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "installerHeaderIcon": "build-resources/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build-resources/installer.nsh"
    }
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "html2canvas": "^1.4.1",
    "i18n-iso-countries": "^7.14.0",
    "maplibre-gl": "^6.14.0",
    "pmtiles": "^4.5.0",
    "proj4": "^2.22.0",
    "shpjs": "^6.2.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
